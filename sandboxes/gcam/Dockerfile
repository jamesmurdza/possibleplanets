# GCAM sandbox image
#
# GCAM (the Global Change Analysis Model, https://github.com/JGCRI/gcam-core)
# is a large C++17 project that has to be compiled from source -- unlike
# every other model in this project, which is a plain pip/Pkg install (see
# docs/sandbox-resource-experiments.md's "GCAM" section for the full
# feasibility writeup this Dockerfile is built from). Multi-stage: compile
# in `builder` with the full toolchain, then copy only the runtime
# artifacts (the ~294MB gcam.exe, its bundled config/jar files) into a
# slim final image -- the build stage's throwaway .o files/toolchain would
# otherwise bloat every sandbox created from this image for no reason.
#
# Three real gotchas found by testing (not documented anywhere official),
# all baked into the RUN steps below instead of needing to be rediscovered:
#
#   1. `git clone --recursive` hangs forever -- one of GCAM's submodules
#      (util/testing-framework) points at stash.pnnl.gov, an internal PNNL
#      server unreachable from outside their network. Not needed to build
#      the gcam executable itself (confirmed: the Makefile never touches
#      it) -- only `hector` and `modelinterface` are actually needed.
#   2. The Makefile needs JARS_LIB set to a directory containing GCAM's own
#      bundled .jar files (already shipped in the repo's own exe/
#      directory) -- undocumented on jgcri.github.io/gcam-doc's own build
#      page.
#   3. The build's peak disk usage (~3.6GB: ~1GB repo + ~750MB .o files +
#      ~700MB libgcam.a + the 294MB exe, plus build-essential/boost/eigen/
#      tbb/jdk) overflows Daytona's 3GB default sandbox disk one step from
#      the end ("No space left on device" at the final `ar` archive step).
#      Confirmed by testing that `disk: 4` (not an arbitrary larger value)
#      is enough, with ~500MB to spare -- see lib/models.ts's `resources`
#      for this model.
#
# Build:  docker build -t gcam-sandbox:v2024.1 .
# Run:    docker run --rm gcam-sandbox:v2024.1 python3 run.py
#
# NOT YET SOLVED (see docs/sandbox-resource-experiments.md): gcam.exe
# builds and exists in this image, but can't actually run a scenario yet.
# Its own configuration_*.xml files point at
# ../input/gcamdata/xml/*.xml -- and input/gcamdata/ in the repo is only
# the gcamdata R package's *source*, not a pre-built XML input database.
# That database has to be generated by running gcamdata's own R data
# pipeline first (a separate, unverified step: R + its own renv-pinned
# package set) -- not attempted in this image. run.py is therefore not
# included here yet; this Dockerfile only covers the confirmed-working
# "build the executable" half of the problem.

FROM debian:12-slim AS builder

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    git \
    build-essential \
    libboost-dev \
    libeigen3-dev \
    libtbb-dev \
    default-jdk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --depth 1 (no full history needed) and only the two submodules the
# Makefile actually needs -- see gotcha #1 above. Pin to a specific commit
# once confirmed working, instead of floating to whatever `main` is on
# every image rebuild, same reasoning as every other sandbox's version
# pins.
RUN git clone --depth 1 https://github.com/JGCRI/gcam-core.git /app/gcam-core \
    && cd /app/gcam-core \
    && git submodule update --init --depth 1 \
       cvs/objects/climate/source/hector \
       output/modelinterface/modelinterface

ENV CXX=g++ \
    BOOST_INCLUDE=/usr/include \
    BOOSTROOT=/usr/include \
    JAVA_INCLUDE=/usr/lib/jvm/default-java/include \
    JAVA_LIB=/usr/lib/jvm/default-java/lib/server \
    EIGEN_INCLUDE=/usr/include/eigen3 \
    TBB_INCLUDE=/usr/lib/x86_64-linux-gnu \
    TBB_LIB=/usr/lib/x86_64-linux-gnu \
    JARS_LIB=/app/gcam-core/exe

# -j4 to match this model's own resources.cpu (see lib/models.ts) -- the
# sandbox this actually builds in only has that many cores anyway.
RUN cd /app/gcam-core/cvs/objects/build/linux && make gcam -j4

# --- final stage -----------------------------------------------------
FROM debian:12-slim

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    default-jre-headless \
    libtbb12 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Only exe/ (the binary itself, its bundled jars, and its
# configuration_*.xml files) -- not the build stage's .o files or
# toolchain. Does NOT include input/ yet (see "NOT YET SOLVED" above);
# this image can't actually run a scenario until that's resolved.
COPY --from=builder /app/gcam-core/exe /app/gcam-core/exe
